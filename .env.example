# Chargeback Bunny configuration.

# --- LLM provider ---
# Any OpenAI-compatible chat-completions endpoint drops in:
#   CHARGEBUNNY_PROVIDER=openai-compatible
#   CHARGEBUNNY_BASE_URL=https://api.openai.com/v1   (or any compatible endpoint)
#   MODEL_API_KEY=sk-...
#   CHARGEBUNNY_MODEL=gpt-4o-mini
CHARGEBUNNY_PROVIDER=
CHARGEBUNNY_BASE_URL=
MODEL_API_KEY=
CHARGEBUNNY_MODEL=

# Debate council judge model (optional). Advocates run on CHARGEBUNNY_MODEL;
# pin the judge to a different model so the council isn't one model grading
# its own reasoning. Omit for same-model council.
CHARGEBUNNY_JUDGE_MODEL=

# Default autonomy policy for new merchants: human | supervised | full
CHARGEBUNNY_AUTONOMY=supervised

# SQLite database location (optional; defaults to ./chargebackbunny.db)
# CHARGEBUNNY_DB=chargebackbunny.db

# --- PayPal ---
# Sandbox app credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Force the fixture-backed mock client (judges run the full demo offline).
# Also the automatic fallback when no PAYPAL_CLIENT_ID/SECRET are set.
# CHARGEBUNNY_PAYPAL_MOCK=1

# --- Offline mode ---
# With no MODEL_API_KEY set, Chargeback Bunny falls back to a deterministic
# heuristic engine (provider "offline") that honors the same JSON schema per
# stage. Every trace is labeled model="offline-heuristic". Useful for
# development and for running the demo with zero credentials.
